<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del logo PR Watch: degradado diagonal azul -> morado -> rosa con brillo y profundidad. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Degradado principal -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="0"
                android:endX="98"
                android:endY="108">
                <item android:offset="0" android:color="#FF2F81F7" />
                <item android:offset="0.52" android:color="#FF8957E5" />
                <item android:offset="1" android:color="#FFDB61A2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brillo superior izquierdo -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="26"
                android:gradientRadius="62">
                <item android:offset="0" android:color="#55FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sombra inferior derecha para dar volumen -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="86"
                android:centerY="92"
                android:gradientRadius="58">
                <item android:offset="0" android:color="#55100828" />
                <item android:offset="1" android:color="#00100828" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
