<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo PR Watch: un grafo git (dos ramas que se fusionan) dentro de un anillo
  de progreso que recuerda al bisel de un smartwatch.
  Todo está dentro de la zona segura del icono adaptativo (radio 33 alrededor del centro).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pista del anillo -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 53.99,24"
        android:strokeWidth="3"
        android:strokeColor="#38FFFFFF"
        android:fillColor="#00000000" />

    <!-- Anillo de progreso (270°) -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 24,54"
        android:strokeWidth="3.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Punto brillante al final del anillo -->
    <path
        android:pathData="M24,54 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0"
        android:fillColor="#FF7EE7FF" />

    <!-- Sombra del grafo -->
    <group android:translateX="1.2" android:translateY="1.6">
        <path
            android:pathData="M46,42 L46,66 M64,46 C64,56 46,52 46,60"
            android:strokeWidth="4.4"
            android:strokeColor="#40140A30"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>

    <!-- Ramas -->
    <path
        android:pathData="M46,42 L46,66"
        android:strokeWidth="4.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M64,46 C64,56 46,52 46,60"
        android:strokeWidth="4.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Commits -->
    <path
        android:pathData="M46,42 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M46,66 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Commit de la rama a fusionar: anillo blanco con centro cian -->
    <path
        android:pathData="M64,46 m-5.6,0 a5.6,5.6 0 1,0 11.2,0 a5.6,5.6 0 1,0 -11.2,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M64,46 m-2.8,0 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0"
        android:fillColor="#FF39D0FF" />
</vector>
